    {
      "name": "invalid record state {'special': 'undefined'}",
      "expected": "invalid",
      "advertised": true,
      "array": true,
      "matches": 1,
      "generation": 1,
      "state": {
        "special": "undefined"
      }
    },
    {
      "name": "invalid advertised type 1",
      "expected": "invalid",
      "advertised": 1,
      "array": true,
      "matches": 1,
      "generation": 1,
      "state": "complete"
    },
    {
      "name": "invalid advertised type true",
      "expected": "invalid",
      "advertised": "true",
      "array": true,
      "matches": 1,
      "generation": 1,
      "state": "complete"
    },
    {
      "name": "invalid advertised type None",
      "expected": "invalid",
      "advertised": null,
      "array": true,
      "matches": 1,
      "generation": 1,
      "state": "complete"
    },
    {
      "name": "invalid array type 1",
      "expected": "invalid",
      "advertised": true,
      "array": 1,
      "matches": 1,
      "generation": 1,
      "state": "complete"
    },
    {
      "name": "invalid array type true",
      "expected": "invalid",
      "advertised": true,
      "array": "true",
      "matches": 1,
      "generation": 1,
      "state": "complete"
    },
    {
      "name": "invalid array type None",
      "expected": "invalid",
      "advertised": true,
      "array": null,
      "matches": 1,
      "generation": 1,
      "state": "complete"
    }
  ]
}
