      "expected": "pending",
      "advertised": true,
      "array": true,
      "matches": 1,
      "generation": 1,
      "state": "pending"
    },
    {
      "name": "record state scanning",
      "expected": "scanning",
      "advertised": true,
      "array": true,
      "matches": 1,
      "generation": 1,
      "state": "scanning"
    },
    {
      "name": "record state complete",
      "expected": "complete",
      "advertised": true,
      "array": true,
      "matches": 1,
      "generation": 1,
      "state": "complete"
    },
    {
      "name": "record state error",
      "expected": "error",
      "advertised": true,
      "array": true,
      "matches": 1,
      "generation": 1,
      "state": "error"
    },
    {
      "name": "invalid record state None",
      "expected": "invalid",
      "advertised": true,
      "array": true,
      "matches": 1,
      "generation": 1,
      "state": null
    },
    {
      "name": "invalid record state True",
      "expected": "invalid",
      "advertised": true,
      "array": true,
      "matches": 1,
      "generation": 1,
      "state": true
    },
    {
      "name": "invalid record state 1",
      "expected": "invalid",
      "advertised": true,
      "array": true,
      "matches": 1,
      "generation": 1,
      "state": 1
    },
    {
      "name": "invalid record state ",
      "expected": "invalid",
      "advertised": true,
      "array": true,
      "matches": 1,
      "generation": 1,
      "state": ""
    },
    {
      "name": "invalid record state Complete",
      "expected": "invalid",
      "advertised": true,
      "array": true,
      "matches": 1,
      "generation": 1,
      "state": "Complete"
    },
    {
      "name": "invalid record state future",
      "expected": "invalid",
      "advertised": true,
      "array": true,
      "matches": 1,
