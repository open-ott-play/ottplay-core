{
  "schema": 1,
  "contract": "Omitted protocol retains legacy fallback; advertised missing selected record waits; matching record must be unique with a safe positive integral generation and one of four states. Classification never authorizes playback or changes generation ownership.",
  "cases": [
    {
      "name": "omitted protocol",
      "expected": "legacy",
      "advertised": false,
      "array": false,
      "matches": 0,
      "generation": null,
      "state": null
    },
    {
      "name": "advertised null/nonarray",
      "expected": "invalid",
      "advertised": true,
      "array": false,
      "matches": 0,
      "generation": null,
      "state": null
    },
    {
      "name": "advertised no selected record",
      "expected": "pending",
      "advertised": true,
      "array": true,
      "matches": 0,
      "generation": null,
      "state": null
    },
    {
      "name": "invalid record count -1",
      "expected": "invalid",
      "advertised": true,
      "array": true,
      "matches": -1,
      "generation": 1,
      "state": "complete"
    },
    {
      "name": "invalid record count 2",
      "expected": "invalid",
      "advertised": true,
      "array": true,
      "matches": 2,
      "generation": 1,
      "state": "complete"
    },
    {
      "name": "invalid record count 1.5",
      "expected": "invalid",
      "advertised": true,
      "array": true,
      "matches": 1.5,
      "generation": 1,
      "state": "complete"
    },
    {
      "name": "invalid record count 1",
      "expected": "invalid",
      "advertised": true,
      "array": true,
      "matches": "1",
      "generation": 1,
      "state": "complete"
    },
    {
      "name": "invalid record count True",
      "expected": "invalid",
      "advertised": true,
      "array": true,
      "matches": true,
      "generation": 1,
      "state": "complete"
    },
    {
      "name": "invalid record count None",
      "expected": "invalid",
      "advertised": true,
      "array": true,
      "matches": null,
      "generation": 1,
      "state": "complete"
    },
    {
      "name": "invalid generation 1",
      "expected": "invalid",
      "advertised": true,
      "array": true,
      "matches": 1,
      "generation": "1",
      "state": "complete"
    },
    {
      "name": "invalid generation True",
      "expected": "invalid",
      "advertised": true,
      "array": true,
      "matches": 1,
      "generation": true,
      "state": "complete"
    },
    {
      "name": "invalid generation False",
      "expected": "invalid",
      "advertised": true,
      "array": true,
      "matches": 1,
      "generation": false,
      "state": "complete"
    },
    {
      "name": "invalid generation None",
      "expected": "invalid",
      "advertised": true,
      "array": true,
      "matches": 1,
      "generation": null,
      "state": "complete"
    },
    {
      "name": "invalid generation 0",
      "expected": "invalid",
      "advertised": true,
      "array": true,
      "matches": 1,
      "generation": 0,
      "state": "complete"
    },
    {
      "name": "invalid generation -1",
      "expected": "invalid",
      "advertised": true,
      "array": true,
      "matches": 1,
      "generation": -1,
      "state": "complete"
    },
    {
      "name": "invalid generation 1.5",
      "expected": "invalid",
      "advertised": true,
      "array": true,
      "matches": 1,
      "generation": 1.5,
      "state": "complete"
    },
    {
      "name": "invalid generation 9007199254740992",
      "expected": "invalid",
      "advertised": true,
      "array": true,
      "matches": 1,
      "generation": 9007199254740992,
      "state": "complete"
    },
    {
      "name": "invalid generation {'special': 'undefined'}",
      "expected": "invalid",
      "advertised": true,
      "array": true,
      "matches": 1,
      "generation": {
        "special": "undefined"
      },
      "state": "complete"
    },
    {
      "name": "invalid generation {'special': 'NaN'}",
      "expected": "invalid",
      "advertised": true,
      "array": true,
      "matches": 1,
      "generation": {
        "special": "NaN"
      },
      "state": "complete"
    },
    {
      "name": "invalid generation {'special': 'Infinity'}",
      "expected": "invalid",
      "advertised": true,
      "array": true,
      "matches": 1,
      "generation": {
        "special": "Infinity"
      },
      "state": "complete"
    },
    {
      "name": "invalid generation {'special': '-Infinity'}",
      "expected": "invalid",
