      "before_sha256": "8b3c9d6871a5e78544f505b53e9019f7b2942881212197f79af5def392aec568",
      "insert": [
        "    function libraryProvider(request: any): LibraryGroup[] {\n",
        "        // Core owns action dependencies. Do not re-serialize the full catalogue\n",
        "        // for an action whose admission and reduction are catalogue-independent.\n",
        "        return libraryCore.classicChannelLibraryNeedsProviderContext(request) ? provider : [];\n",
        "    }\n",
        "    function reduceLibraryDraft(draft: LibraryDocument, request: any): void {\n",
        "        var next = libraryCore.classicChannelLibraryReduce(\n",
        "            draft, libraryProvider(request), request, resolve, Math.random\n",
        "        );\n",
        "        Object.keys(draft).forEach(function (field) { delete (draft as any)[field]; });\n",
        "        Object.keys(next).forEach(function (field) { (draft as any)[field] = next[field]; });\n",
        "    }\n",
        "    function libraryAction(request: any, durable = false): any {\n",
        "        request.version = 1;\n",
        "        var decision = libraryCore.classicChannelLibraryDecision(\n",
        "            state!, libraryProvider(request), request, resolve\n",
        "        );\n",
        "        if (!decision.accepted) return request.action === \"create\" ? null : false;\n",
        "        if (!decision.commit) return decision.result;\n",
        "        return commit(function (draft) { reduceLibraryDraft(draft, request); }, durable)\n",
        "            ? decision.result : request.action === \"create\" ? null : false;\n"
      ]
    },
