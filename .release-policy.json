{
  "repository": "open-ott-play/ottplay-core",
  "mode": "release",
  "default_branch": "main",
  "visibility": "public",
  "version_file": "shared-core/package.json",
  "validation_workflows": [
    "core-release-validation.yml"
  ],
  "artifact_pattern": "release-assets*",
  "local_checks": [
    "python3 -m unittest discover -s .github/release-tests -p test_core_distribution.py",
    "npm ci --ignore-scripts --prefix shared-core",
    "npm --prefix shared-core run pack:core",
    "npm --prefix shared-core run check:js",
    "npm --prefix shared-core run check:core"
  ],
  "notes": [
    "Releases package the actual JVM17 and ES5 shared-core compiler output, type declarations and original license notices. FOSS2 remains independently versioned under its existing foss2-* tags.",
    "Qualification uses the existing portable, browser-consumer and wire-contract checks without the vendor delivery job. Candidate publication does not update consumers or establish device acceptance."
  ],
  "release_notes": "CHANGELOG.md",
  "single_entry_ci": false,
  "fuzzing": {
    "toolkit_ref": "6b2d99519d513d2b871d2a845ddd6134dea4af2c"
  },
  "versioning": {
    "schema": 1,
    "promotion": "promote-bytes",
    "files": [
      {
        "path": "shared-core/package.json",
        "format": "json",
        "field": "version",
        "value": "package"
      },
      {
        "path": "shared-core/package-lock.json",
        "format": "npm-lock",
        "package": "ottplay-shared-core-validation",
        "value": "package"
      },
      {
        "path": "shared-core/kotlin-js-store/package-lock.json",
        "format": "npm-lock",
        "package": "ottplay-shared-core",
        "value": "package"
      },
      {
        "path": "shared-core/kotlin-js-store/package-lock.json",
        "format": "json",
        "package": "ottplay-shared-core",
        "field": [
          "packages",
          "packages/OttPlayCore",
          "version"
        ],
        "value": "package"
      },
      {
        "path": "shared-core/kotlin-js-store/package-lock.json",
        "format": "json",
        "package": "ottplay-shared-core",
        "field": [
          "packages",
          "packages/OttPlayCore-test",
          "version"
        ],
        "value": "package"
      }
    ],
    "artifacts": [
      {
        "path": "ottplay-core.manifest.json",
        "format": "json",
        "field": "version",
        "value": "package"
      }
    ],
    "toolkit_revision": "f0bf0ec4921619f0de09ecd3eaa5e8673e4f9695"
  },
  "toolkit_revision": "f0bf0ec4921619f0de09ecd3eaa5e8673e4f9695"
}
