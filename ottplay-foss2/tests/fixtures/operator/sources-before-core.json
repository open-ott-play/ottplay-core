          "url": "https://xc.test/base",
          "username": "u",
          "password": "p"
        },
        "item": {
          "sourceId": " src ",
          "kind": "live"
        }
      },
      "expected": [
        [
          "done",
          {
            "code": "FOLDER_REQUIRED",
            "message": "Select a folder to browse"
          },
          null
        ]
      ]
    },
    {
      "input": {
        "mode": "resolve",
        "item": {
          "kind": "folder"
        }
      },
      "expected": [
        [
          "done",
          {
            "code": "FOLDER_REQUIRED",
            "message": "Open this folder before choosing a video"
          },
          null
        ]
      ]
    },
    {
      "input": {
        "mode": "resolve",
        "item": {
          "kind": "live",
          "url": "ftp://bad"
        }
      },
      "expected": [
        [
          "done",
          {
            "code": "STREAM_URL",
            "message": "This channel has no supported HTTP or HTTPS stream URL"
          },
          null
        ]
      ]
    },
    {
      "input": {
        "mode": "resolve",
        "item": {
          "kind": "live",
          "url": "https://valid.test/live"
        }
      },
      "expected": [
        [
          "done",
          null,
          {
            "url": "https://valid.test/live",
            "channel": {
              "kind": "live",
              "url": "https://valid.test/live"
            }
          }
        ]
      ]
    }
  ]
