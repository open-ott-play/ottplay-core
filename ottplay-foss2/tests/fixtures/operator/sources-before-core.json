      "expected": [
        [
          "done",
          {
            "code": "SOURCE_ID",
            "message": "A persistent source ID is required"
          },
          null
        ]
      ]
    },
    {
      "input": {
        "source": {
          "id": "",
          "type": "xtream",
          "url": "https://xc.test/base",
          "username": "u",
          "password": "p"
        }
      },
      "expected": [
        [
          "done",
          {
            "code": "SOURCE_ID",
            "message": "A persistent source ID is required"
          },
          null
        ]
      ]
    },
    {
      "input": {
